# ===========================================
# CIN EVENT MANAGEMENT SYSTEM - ENVIRONMENT
# ===========================================

# Database Configuration (MySQL)
MYSQL_DATABASE=cin_db
MYSQL_USER=cin_user
MYSQL_PASSWORD=cin_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Django Configuration
SECRET_KEY=your_secret_key_here_change_this_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
APP_DOMAIN=http://localhost:8000

# ===========================================
# EMAIL CONFIGURATION (MAILHOG SMTP)
# ===========================================
# Mailhog SMTP settings for development
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@cin-event.com


# ===========================================
# PHPMYADMIN CONFIGURATION (OPTIONAL)
# ===========================================
# phpMyAdmin uses the MySQL credentials above
# Access at http://localhost:5050

# ===========================================
# SECURITY SETTINGS (PRODUCTION)
# ===========================================
# Uncomment and configure for production
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True
# X_FRAME_OPTIONS=DENY

