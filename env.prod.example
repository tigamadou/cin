# CIN Event Management System - Production Environment
# ===================================================

# Database Configuration (MySQL)
MYSQL_DATABASE=cin_prod
MYSQL_USER=cin_user
MYSQL_PASSWORD=your_secure_production_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Django Configuration
SECRET_KEY=your_very_secure_secret_key_for_production_change_this
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,panel.yourdomain.com,www.panel.yourdomain.com,api.yourdomain.com,www.api.yourdomain.com
APP_DOMAIN=https://yourdomain.com

# Cookie Domain Configuration (for cross-subdomain cookie sharing)
# Set to .yourdomain.com (with leading dot) to allow cookies across all subdomains
CSRF_COOKIE_DOMAIN=.yourdomain.com
SESSION_COOKIE_DOMAIN=.yourdomain.com

# ===========================================
# FRONTEND API CONFIGURATION
# ===========================================
# API domain for frontend API calls (used by Vite build process)
API_DOMAIN=https://api.yourdomain.com
# VITE_API_URL is set during build from API_DOMAIN
# VITE_API_URL=https://api.yourdomain.com

# ===========================================
# DJANGO SUPERUSER CONFIGURATION
# ===========================================
# These variables are used for non-interactive superuser creation
# Required for automated deployments. Use strong passwords in production!
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=your_secure_superuser_password_here

# ===========================================
# EMAIL CONFIGURATION (PRODUCTION SMTP)
# ===========================================
# Production SMTP settings
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PASSWORD=your_redis_password_here

# ===========================================
# SECURITY SETTINGS (PRODUCTION)
# ===========================================
# Uncomment and configure for production
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ===========================================
# MONITORING (OPTIONAL)
# ===========================================
# SENTRY_DSN=your_sentry_dsn_here
# PROMETHEUS_ENABLED=True
